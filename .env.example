PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
SKIP_AUTH_VALIDATION=true
PUBLIC_OAUTH_URL=https://your-gcp-project-id.web.app/oauth.html
# DEFAULT_USER is optional. If omitted, the active signed-in gcloud user is dynamically detected
# DEFAULT_USER=user@example.com
